# ===========================================================================
# FortressStack — .gitignore
# ===========================================================================

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
# PyInstaller / packaging
*.spec

# Virtual environments
.venv/
venv/
env/
ENV/

# Type checking / lint
.mypy_cache/
.ruff_cache/
.pytype/
.dmypy.json

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# --- Tests / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml

# --- Frontend (Node) ---
node_modules/
admin-frontend/dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Secrets (NEVER commit real credentials) ---
# Keep these around safely; the stack falls back to non-secret defaults.
*.env
.env.*
!.env.example
admin-backend/.env
backend/.env

# --- Runtime data / volumes ---
*.db
*.sqlite
*.sqlite3
/data/
/backups/
*.log

# --- Uploads / RAG storage ---
uploads/
uploaded/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
desktop.ini