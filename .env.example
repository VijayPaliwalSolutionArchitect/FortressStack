# FortressStack — .env example
# Copy to .env next to docker-compose.yml (compose interpolates it).
# NEVER commit real values — this file ships placeholders only.

# --- Secrets required by docker-compose.yml (CHANGE all of these) ---------
# POSTGRES_PASSWORD=strong-random-password
# LITELLM_MASTER_KEY=sk-fortress-[REDACTED-long-random]
# WEBUI_SECRET_KEY=[REDACTED-random]            # Open WebUI session secret
# NEXTAUTH_SECRET=[REDACTED-random]             # Langfuse auth
# LANGFUSE_SALT=[REDACTED-random]               # Langfuse
# LANGFUSE_ENCRYPTION_KEY=[REDACTED-32-byte-key] # Langfuse (32-byte)

# --- Admin backend (admin-backend, port 8000) — flat FORTRESS_* overrides --
# FORTRESS_CONFIG_DIR=config                # dir with layered YAML (default: config)
# FORTRESS_DATABASE_URL=postgresql://fortress:[REDACTED]@postgres:5432/fortress
# FORTRESS_ENVIRONMENT=production           # development|staging|production
# FORTRESS_DEBUG=false
# FORTRESS_LOCAL_MODE=true                  # true = refuse ALL external egress
# FORTRESS_GATEWAY__BASE_URL=http://litellm:4000
# FORTRESS_GATEWAY__MASTER_KEY=[REDACTED]   # LiteLLM master key (secret)
# FORTRESS_GATEWAY__TIMEOUT_SECONDS=60
# FORTRESS_GATEWAY__MAX_RETRIES=2
# FORTRESS_GATEWAY__FALLBACK_MODELS=qwen2.5:7b
# FORTRESS_RAG__CHUNK_SIZE=512
# FORTRESS_RAG__CHUNK_OVERLAP=64
# FORTRESS_RAG__EMBEDDING_MODEL=nomic-embed-text
# FORTRESS_RAG__TOP_K=5
# FORTRESS_RAG__SIMILARITY_THRESHOLD=0.55
# FORTRESS_RAG__UPLOAD_DIR=/data/uploads
# FORTRESS_RAG__MAX_FILE_MB=50
# FORTRESS_TEAM__DEFAULT_BUDGET_USD=50.0
# FORTRESS_TEAM__DEFAULT_RATE_LIMIT_RPM=60
# FORTRESS_AUTH__JWT_SECRET=[REDACTED]
# FORTRESS_AUTH__JWT_EXPIRY_MINUTES=60
# FORTRESS_AUTH__SSO_ENABLED=true
# FORTRESS_OBSERVABILITY__ENABLED=true
# FORTRESS_OBSERVABILITY__LANGFUSE_HOST=http://langfuse:3000
# FORTRESS_OBSERVABILITY__PUBLIC_KEY=[REDACTED]
# FORTRESS_OBSERVABILITY__SECRET_KEY=[REDACTED]
# FORTRESS_BACKUP__ENABLED=true
# FORTRESS_BACKUP__SCHEDULE_CRON=0 2 * * *
# FORTRESS_BACKUP__DESTINATION=/backups
# FORTRESS_BACKUP__RETENTION_DAYS=30

# --- FortressStack Gateway (backend, port 4001) ------------------------------
# FORTRESS_GATEWAY_CONFIG=config/gateway.yaml   # path to gateway YAML (relative to backend/)
# FORTRESS_HOST=0.0.0.0
# FORTRESS_PORT=4001
# FORTRESS_ENVIRONMENT=production
# FORTRESS_DEBUG=false
# FORTRESS_LOCAL_MODE=true
# FORTRESS_OLLAMA__BASE_URL=http://ollama:11434
# FORTRESS_DEFAULT_MODEL=llama3.1:8b
# FORTRESS_REQUIRE_AUTH=true                    # /v1/* then demands Bearer master key
# FORTRESS_TIMEOUT_SECONDS=60
# FORTRESS_MAX_RETRIES=2
# FORTRESS_ALLOWED_ORIGINS=*
# LITELLM_MASTER_KEY=[REDACTED]                 # gateway master key (env-only, never YAML)
# FORTRESS_GATEWAY_MASTER_KEY=[REDACTED]        # alternate env var for the same key
