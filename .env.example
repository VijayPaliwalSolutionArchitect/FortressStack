# FortressStack — .env example
# Copy to backend/.env. NEVER commit real secrets — keys live in env only.

# --- Master key (required when FORTRESS_REQUIRE_AUTH=true) ---
# LITELLM_MASTER_KEY=
# FORTRESS_GATEWAY_MASTER_KEY=

# --- Gateway config file (relative to backend/) ---
# FORTRESS_GATEWAY_CONFIG=config/gateway.yaml

# --- Flat env overrides (highest precedence): FORTRESS_<section>__<key> ---
# FORTRESS_ENVIRONMENT=production
# FORTRESS_DEBUG=false
# FORTRESS_HOST=0.0.0.0
# FORTRESS_PORT=4001
# FORTRESS_LOCAL_MODE=true          # true = refuse ALL external egress
# FORTRESS_OLLAMA_BASE_URL=http://ollama:11434
# FORTRESS_DEFAULT_MODEL=llama3.1:8b
# FORTRESS_REQUIRE_AUTH=true
# FORTRESS_TIMEOUT_SECONDS=60
# FORTRESS_MAX_RETRIES=2
# FORTRESS_ALLOWED_ORIGINS=*
